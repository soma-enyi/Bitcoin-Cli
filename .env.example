# BTC-CLI environment. Copy to .env and fill in. .env is gitignored: never commit real keys.
# Real environment variables and command-line flags (-n, --rpc-url, ...) override these values.

# Which network to use: regtest | signet | testnet4 | mainnet.
# Switch per run:   BTC_NETWORK=regtest btc node status      or      btc -n mainnet node status
# Offline features (keys, mnemonics, derive, address, multisig, psbt, tx) work on every network.
# On mainnet they handle REAL FUNDS: keep secrets out of chat and screenshots.
BTC_NETWORK=mainnet

# Node settings are per network: BTC_<NETWORK>_RPC_URL, _RPC_COOKIE, _RPC_USER, _RPC_PASSWORD, _RPC_API_KEY.
# When a section exists for the selected network it REPLACES the plain BTC_RPC_* variables,
# so a mainnet key can never be sent to a regtest node. The tool also refuses to run when the
# node's chain does not match the selected network.

# --- mainnet: hosted gateway (BitRPC). Paste your key after the = (no quotes or spaces) ---
BTC_MAINNET_RPC_URL=https://bitrpc.thebuidl.xyz/bitcoin
BTC_MAINNET_RPC_API_KEY=

# Fee estimates on mainnet (your gateway cannot estimate fees itself). Test networks always use
# the node's own estimator and ignore these.
#   node    only the node's estimator, then the labelled mempool minimum
#   public  a public fee service (default Blockstream); it learns your IP address
#   blocks  computed from the last few blocks read through your gateway: private, but ~10 MB per block
BTC_MAINNET_FEE_SOURCE=public
# BTC_MAINNET_FEE_API_URL=https://blockstream.info/api/fee-estimates
# BTC_MAINNET_FEE_BLOCKS=3

# --- regtest: your own local node ---
BTC_REGTEST_RPC_URL=http://127.0.0.1:18443
# Cookie auth is the default (~/.bitcoin/regtest/.cookie). "~" is NOT expanded in .env files,
# so use an absolute path if yours is elsewhere:
# BTC_REGTEST_RPC_COOKIE=/home/YOUR_USER/.bitcoin/regtest/.cookie
# or user/password (rpcuser= / rpcpassword= in bitcoin.conf):
# BTC_REGTEST_RPC_USER=bitcoin
# BTC_REGTEST_RPC_PASSWORD=your-password

# Same pattern for BTC_SIGNET_* and BTC_TESTNET4_*.
